# name: test_structure_snapshot[real_example]
  Zettel title='' filetags=''
    Properties CREATION_TIME='2025-03-07T19:28:13+0000', ID='324008AA-268C-4504-BD7C-488C18B2A3F6'
    FlatText
      BlankLines x1
      Paragraph
        ParagraphText
          str 'Let '
          InlineLatex content='X'
          str ' be a '
          Link target='id:7D0EC5C1-73C1-4CA7-9B4F-B017307F8B72'
            str 'compact'
          str ' pretopological space.  For any family '
          InlineLatex content='(C_i)_{i \\in I}'
          str ' of closed subsets of '
          InlineLatex content='X'
          str ' such that '
          InlineLatex content='\\bigcap_{i \\in I} C_i = \\emptyset'
          str ', there exists a finite subset '
          InlineLatex content='J \\subseteq I'
          str ' such that '
          InlineLatex content='\\bigcap_{i \\in J} C_i = \\emptyset'
          str '.  Taken complements, this shows that any open cover of '
          InlineLatex content='X'
          str ' has a finite subcover.\n'
      BlankLines x1
    Headline level=1 title='proof'
      FlatText
        BlankLines x1
        Paragraph
          ParagraphText
            str 'Suppose, on the contrary, that each finite subset '
            InlineLatex content='J \\subseteq I'
            str ' has '
            InlineLatex content='\\bigcap_{i \\in J} C_i \\neq \\emptyset'
            str '.  Then\n'
          LatexBlock type=EQUATION, text='\\begin{equation*}\n\\mathcal{F} = \\Set{ \\bigcap_{i \\in J} C_i | J \\subseteq I \\land \\left| J \\right| < \\aleph_0 }\n\\end{equation*}\n'
          ParagraphText
            str 'is trivially a filter base on '
            InlineLatex content='X'
            str '.  Let '
            InlineLatex content='x'
            str ' be a '
            Link target='id:65DDF6EF-9630-4E14-86AF-E7821FA78A64'
              str 'cluster point'
            str ' of '
            InlineLatex content='\\mathcal{F}'
            str '.  Then '
            InlineLatex content='x'
            str ' is also a cluster point of each '
            InlineLatex content='C_i'
            str ' ('
            Link target='id:238FB567-C426-4797-9756-A2444D791A81'
              str 'why'
            str '), so '
            InlineLatex content='x \\in C_i'
            str ' for all '
            InlineLatex content='i \\in I'
            str ' ('
            Link target='id:126F40D8-D7A0-43F5-8187-AB49582483C8'
              str 'why'
            str ').  But '
            InlineLatex content='\\bigcap_{i \\in I} C_i'
            str ' is empty, contradiction.  '
            InlineLatex content='\\square'
            str '\n'
        BlankLines x1
    Headline level=1 title='reference'
      FlatText
        BlankLines x1
        Paragraph
          ParagraphText
            str 'Generalising\n'
          List bullet='-'
            Item checked=None
              FlatText
                Paragraph
                  ParagraphText
                    str 'Boubaki, General Topology, Chapter 1, § 9, no. 1, pp. 83--84.\n'
        BlankLines x1
    Headline level=1 title='converse not true'
      FlatText
        BlankLines x1
        Paragraph
          ParagraphText
            str 'The converse statement is not true: Let '
            InlineLatex content="X'"
            str ' be the topological space induced by '
            InlineLatex content='X'
            str '.  Then '
            InlineLatex content="X'"
            str ' being compact does not imply that '
            InlineLatex content='X'
            str ' is compact.  Consider '
            InlineLatex content='\\mathbb{Z}'
            str ' equipped with a pretopological structure: each '
            InlineLatex content='\\mathcal{N}(x)'
            str ' is generated by '
            InlineLatex content='\\{x-1, x, x+1\\}'
            str '.  Then the topology induced on '
            InlineLatex content='\\mathbb{Z}'
            str ' is trivial, thus compact, but '
            InlineLatex content='\\mathbb{Z}'
            str ' as a pretopological space is not compact, since the filter '
            InlineLatex content='\\{\\mathbb{Z}_{\\geq x} \\mid x \\in \\mathbb{Z}\\}'
            str ' has no cluster point.  '
            InlineLatex content='\\triangle'
            str '\n'
        BlankLines x1
        Paragraph
          ParagraphText
            str 'However, the converse is clearly true if '
            InlineLatex content='X'
            str ' is a topological space.  Note that this does not characterise '
            InlineLatex content='X'
            str ' being a topological space in any way.  Consider a finite pretopological space '
            InlineLatex content='X'
            str ' that is not a topological space.  Then any subspace of '
            InlineLatex content='X'
            str ' is finite, and thus compact both as a pretopological space and as a topology space.\n'
  
