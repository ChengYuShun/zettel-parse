# serializer version: 1
# name: test_structure_snapshot[nested_lists]
  Zettel title='' filetags=''
    FlatText
      Paragraph
        List bullet='-'
          Item checked=None
            FlatText
              Paragraph
                ParagraphText
                  str 'a\n'
                LatexBlock type=BRACKET, text='\\[\na\n\\]\n'
                List bullet='+'
                  Item checked=None
                    FlatText
                      Paragraph
                        ParagraphText
                          str '+ fooo\n'
                        List bullet='+'
                          Item checked=None
                            FlatText
                              Paragraph
                                ParagraphText
                                  str 'bar\n'
                  Item checked=None
                    FlatText
                      Paragraph
                        ParagraphText
                          str 'star as bullet\n'
  
# ---
# name: test_structure_snapshot[standard]
  Zettel title='Test' filetags=':global:llm:'
    Properties ID='foo bar'
    FlatText
      BlankLines x1
      Paragraph
        ParagraphText
          str 'abc s '
          Italic
            str 'slanted'
          str '.  '
          InlineLatex content='a^2 + b^2 = c^2'
          str '.\nanother line\n'
      BlankLines x1
      Paragraph
        LatexBlock type=BRACKET, text='\\[abc\n\\]\n'
      BlankLines x1
      Paragraph
        LatexBlock type=TIKZCD, text='\\begin{tikzcd}\na\n\\end{tikzcd}\n'
      BlankLines x1
    Headline level=1 title='heading'
      Properties ID='buzz'
      FlatText
        BlankLines x1
  
# ---
